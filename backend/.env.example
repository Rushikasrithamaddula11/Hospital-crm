# Environment Configuration for Mentneo Hospital CRM Backend

# App Configuration
APP_ENV=development
APP_NAME=Mentneo Hospital CRM
API_V1_STR=/api/v1
SECRET_KEY=mentneo_hospital_crm_super_secret_key_change_in_production_2026

# Database Configuration
# Options: postgresql, sqlite, firebase
DATABASE_URL=sqlite:///./hospital_crm.db

# Firebase Configuration
USE_FIREBASE=false
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=mentneo-hospital-crm

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
